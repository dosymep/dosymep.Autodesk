<Project>
    <PropertyGroup>
        <Platforms>x64</Platforms>
        <OutputType>Library</OutputType>
    </PropertyGroup>
    
    <PropertyGroup>
        <!--> OpenMcdf <-->
        <NoWarn>NU1902</NoWarn>
    </PropertyGroup>
    
    <PropertyGroup>
        <Nullable>disable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>dosymep</Authors>
        <RepositoryType>Git</RepositoryType>
        <RepositoryUrl>https://github.com/dosymep/dosymep.Autodesk</RepositoryUrl>
        <PackageProjectUrl>https://github.com/dosymep/dosymep.Autodesk</PackageProjectUrl>
        <PackageTags>dosymep, autodesk, revit, navisworks, bim360</PackageTags>
    </PropertyGroup>
</Project>